{
	"$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
	"organizeImports": { "enabled": true },
	"formatter": {
		"enabled": true,
		"lineWidth": 120,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"include": ["packages/helm-ask-user-question/**"],
			"formatter": { "enabled": false },
			"organizeImports": { "enabled": false },
			"linter": { "enabled": false }
		},
		{
			"include": ["packages/helm-ask-user-question/remote-answers.ts"],
			"formatter": { "enabled": true },
			"organizeImports": { "enabled": true },
			"linter": { "enabled": true }
		}
	],
	"files": {
		"ignore": [
			"dist",
			"node_modules",
			".pi-subagents",
			"helm.config.json",
			"vigil.config.json",
			"profiles.json",
			"profiles",
			"storybook-static",
			"app/test-results",
			"app/remote-dist"
		]
	}
}
