{
	"name": "helm",
	"productName": "Helm",
	"private": true,
	"version": "0.1.0",
	"description": "Orchestrator cockpit for the helm daemon: native sidebar + real terminal",
	"main": "dist/main.cjs",
	"scripts": {
		"build": "npm --prefix .. run build && node scripts/rebuild-native-window-zoom-guard.mjs && node scripts/build-document-canvas.mjs && tsc --noEmit && node build.mjs",
		"start": "bun run build && bun run brand-electron && electron .",
		"side-by-side": "bash scripts/side-by-side.sh",
		"typecheck": "node scripts/build-document-canvas.mjs && tsc --noEmit",
		"typecheck:storybook": "node scripts/build-document-canvas.mjs && tsc --noEmit -p .storybook/tsconfig.json",
		"rebuild": "electron-rebuild -f -w node-pty && node scripts/rebuild-native-window-zoom-guard.mjs --force",
		"rebuild-native-window-zoom": "node scripts/rebuild-native-window-zoom-guard.mjs --force",
		"brand-electron": "node scripts/brand-macos-electron.mjs",
		"attest:profile-switch": "node scripts/profile-switch-attestation.mjs --require-electron --require-dtach",
		"postinstall": "electron-rebuild -f -w node-pty && node scripts/rebuild-native-window-zoom-guard.mjs --force && node scripts/brand-macos-electron.mjs",
		"storybook": "node scripts/build-document-canvas.mjs && storybook dev -p 6006",
		"storybook:build": "node scripts/build-document-canvas.mjs && storybook build",
		"playwright:install": "playwright install chromium",
		"test:browser": "playwright test",
		"test:browser:headed": "playwright test --headed"
	},
	"dependencies": {
		"@blocknote/ariakit": "0.51.4",
		"@blocknote/core": "0.51.4",
		"@blocknote/react": "0.51.4",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-serialize": "^0.14.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"marked": "18.0.11",
		"node-pty": "^1.1.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-reconciler": "0.33.0"
	},
	"devDependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-css": "6.3.1",
		"@codemirror/lang-html": "6.4.12",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/lang-json": "6.0.2",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/lang-python": "6.2.1",
		"@codemirror/language": "6.13.1",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.14",
		"@electron/rebuild": "^4.1.0",
		"@lezer/highlight": "1.2.5",
		"@playwright/test": "^1.62.0",
		"@storybook/react-vite": "^10.5.0",
		"@tanstack/react-virtual": "3.14.26",
		"@types/node": "^24.0.0",
		"@types/papaparse": "5.5.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-reconciler": "0.32.3",
		"docx-preview": "0.4.1",
		"electron": "^43.0.0",
		"esbuild": "^0.28.1",
		"jszip": "3.10.2",
		"papaparse": "5.7.0",
		"pdfjs-dist": "6.4.299",
		"postal-mime": "4.2.0",
		"smol-toml": "1.9.1",
		"storybook": "^10.5.0",
		"typescript": "^5.9.3",
		"vite": "^8.1.4",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"yaml": "2.9.1"
	},
	"trustedDependencies": ["electron", "node-pty", "@electron/rebuild"]
}
